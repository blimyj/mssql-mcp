# Copy to .env and fill in. .env is git-ignored; this template is committed.

# --- Connection (the same values you type into SSMS's Connect dialog) ---
# "Server name" in SSMS -> host + port
MSSQL_SERVER=localhost
MSSQL_PORT=1433

# "Login" / "Password" (SQL Server Authentication)
MSSQL_USER=user
MSSQL_PASSWORD=change-me

# Default database to connect to
MSSQL_DATABASE=master

# --- Multiple databases ---
# If databases.json exists next to this file (or MSSQL_CONFIG points at one),
# it defines the databases and the connection settings above become fallbacks.
# See databases.example.json. Passwords can stay here and be referenced from
# databases.json with "passwordEnv": "MSSQL_PASSWORD".
# MSSQL_CONFIG=databases.json

# --- Schema filtering & description (single-database mode) ---
# Comma-separated schemas to hide from listings and block in queries (applies to every db)
MSSQL_EXCLUDE_SCHEMAS=
# Let a tool call pass includeExcludedSchemas=true to see excluded schemas when really needed
MSSQL_ALLOW_EXCLUDED_OVERRIDE=true
# Guidance for the agent (single-database mode; databases.json has the same keys)
# Summary: what the database is and when to use it. Sent on connect.
MSSQL_SUMMARY=
# Full notes, e.g. how to query it. Shown by describe_database (inline, or a file path)
MSSQL_DESCRIPTION=
MSSQL_DESCRIPTION_FILE=

# --- TLS (defaults are right for a local Colima/Docker container) ---
# Local containers use a self-signed cert, so we trust it.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false

# --- Safety ---
# Read-only is the default even if this line is removed. Only the exact value
# false allows writes (INSERT/UPDATE/DDL); anything else stays read-only.
MSSQL_READONLY=true

# Per-request timeout (ms)
MSSQL_REQUEST_TIMEOUT=30000

# --- Rate limiting (protect the DB server from spamming); 0 disables a limit ---
# max requests per window
MSSQL_RATE_MAX=3
# the sliding window (ms)
MSSQL_RATE_WINDOW_MS=10000
# max simultaneous in-flight queries
MSSQL_MAX_CONCURRENT=1

# --- Output ---
# compact = single-line JSON, rows as arrays under one "columns" header (fewer tokens)
# pretty  = indented JSON, rows as objects (the old format)
MSSQL_OUTPUT=compact

# --- Debug logging ---
# true = append human-readable client input/output to mssql-mcp/mcp.log
MSSQL_LOG=false
# custom log path (default: mssql-mcp/mcp.log, git-ignored)
MSSQL_LOG_FILE=
# max chars per logged payload before clipping
MSSQL_LOG_MAX=20000
